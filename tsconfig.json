{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["realm.ts", "realm/**/*.ts", "wasm/**/*.ts", "tests/**/*.ts"]
}
