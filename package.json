{
  "name": "realm-chess",
  "version": "0.5.0",
  "private": true,
  "description": "A chessboard, a strong engine, and the plans behind its best moves, as a captured Embabel realm",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vendor": "node scripts/vendor-chess.mjs",
    "vendor:sdk": "node scripts/vendor-sdk.mjs",
    "book": "node scripts/book.mjs",
    "app": "node scripts/app.mjs",
    "synth": "node scripts/synth.mjs",
    "build": "npm run vendor && npm run book && npm run app && npm run synth",
    "check": "npm run typecheck && npm run build && npm test && npm run test:app",
    "test:app": "playwright test"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@embabel/realm-synth": "file:vendor/sdk/embabel-realm-synth-0.1.0.tgz",
    "@embabel/realm-types": "file:vendor/sdk/embabel-realm-types-0.1.0.tgz",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "cm-chessboard": "^8.15.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
